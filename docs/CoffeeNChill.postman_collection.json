            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Uploaded handbook.pdf is present\", function () {",
                  "    const docs = pm.response.json();",
                  "    const found = docs.find((d) => d.FileName === \"handbook.pdf\");",
                  "    pm.expect(found).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"Documents are sorted newest first\", function () {",
                  "    const docs = pm.response.json();",
                  "    for (let i = 1; i < docs.length; i++) {",
                  "        const prev = new Date(docs[i - 1].lastModified).getTime();",
                  "        const curr = new Date(docs[i].lastModified).getTime();",
                  "        pm.expect(prev).to.be.at.least(curr);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
