        {
          "name": "Get All Menu Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"No menu item has a zeroed-out price\", function () {",
                  "    const items = pm.response.json();",
                  "    items.forEach((item) => {",
                  "        pm.expect(item.price, `price for ${item.rowKey}`).to.not.eql(\"0\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Seeded latte01 item is present\", function () {",
                  "    const items = pm.response.json();",
                  "    const found = items.find((i) => i.rowKey === pm.collectionVariables.get(\"lastId\"));",
                  "    pm.expect(found).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
